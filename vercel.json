
{
  "version": 2,
  "buildCommand": "node stamp-pi-release.cjs",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/pi.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/pi-release.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/shared-awakening",
      "destination": "https://wakeupmap-globalversion.vercel.app/api/wakeuphere"
    },
    {
      "source": "/api/shared-awakening-content",
      "destination": "https://wakeupmap-globalversion.vercel.app/api/wake-up-now"
    },
    {
      "source": "/api/shared-awakening-image",
      "destination": "https://wakeupmap-globalversion.vercel.app/api/wake-up-image"
    },
    {
      "source": "/api/config",
      "destination": "/api/config"
    },
    {
      "source": "/api/find-city-geonames",
      "destination": "/api/find-city-geonames"
    },
    {
      "source": "/api/translate-location",
      "destination": "/api/translate-location"
    },
    {
      "source": "/api/generateStory",
      "destination": "/api/generateStory"
    },
    {
      "source": "/api/generatePiStory",
      "destination": "/api/generatePiStory"
    },
    {
      "source": "/api/save-record",
      "destination": "/api/save-record"
    }
  ]
} 
